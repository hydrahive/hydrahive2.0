; Engine configuration file.
; Game Studio PR 0 — deterministic Godot microVM proof fixture.
config_version=5

[application]
config/name="HydraHive Game Runtime Proof"
run/main_scene="res://main.tscn"

[display]
window/size/viewport_width=160
window/size/viewport_height=90
window/size/window_width_override=160
window/size/window_height_override=90

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.02, 0.04, 0.08, 1)
