#!/usr/bin/env python3
"""hh-portforward — Root-Helfer für Container-Portfreigaben.

docs/specs/container-nat-ports.md. Wird vom HydraHive-Backend per
`sudo -n /usr/local/sbin/hh-portforward <aktion> …` aufgerufen. sudoers
erlaubt NUR diesen Befehl. Jede Eingabe wird hier erneut streng geprüft;
dem Aufrufer wird nicht vertraut.

Aktionen:
  apply  <id> <proto> <hstart> <hend> <ip> <cstart> <scope> <wan_if>
  remove <id>
  list   (JSON {"ufw": installiert?, "rules": gespeicherte hh-port-Regeln})

Regeln werden geschrieben und gelöscht, egal ob ufw gerade an oder aus ist: ufw
speichert sie auch ausgeschaltet und wendet sie beim Einschalten an. Gesucht wird
über `ufw show added` (listet auch ausgeschaltet), gelöscht über den Regeltext
(`ufw route delete allow …`, ohne Nummer). Früher wurde bei ausgeschaltetem ufw
nichts geschrieben, aber Erfolg gemeldet – nach `ufw enable` waren die Freigaben
dicht (VPS 06.10.2026). Nur Regeln mit Kommentar hh-port:<id> werden angefasst.
"""
from __future__ import annotations

import ipaddress
import json
import os
import re
import shlex
import subprocess
import sys

UFW = "/usr/sbin/ufw"
NAT_NET = ipaddress.ip_network("10.10.0.0/24")
NAT_IF = "hhnat0"
ID_RE = re.compile(r"^[0-9a-f-]{8,40}$")
IF_RE = re.compile(r"^[a-zA-Z0-9_.-]{1,15}$")
COMMENT_PREFIX = "hh-port:"
RESERVED = {22, 53, 80, 443, 3000, 3001, 5432, 6379, 8001, 8888, 9000, 9001, 10000, 41641}
# Genau die Form, die apply() schreibt – alles andere ist nicht unsere Regel.
OWN_RULE = re.compile(
    r"^allow in on (?P<in>[a-zA-Z0-9_.-]{1,15}) out on " + NAT_IF
    + r" to (?P<ip>[0-9.]+) port (?P<port>\d{1,5}(?::\d{1,5})?) proto (?P<proto>tcp|udp)"
    + r" comment hh-port:(?P<id>[0-9a-f-]{8,40})$"
)


def die(msg: str, code: int = 2) -> None:
    print(f"hh-portforward: {msg}", file=sys.stderr)
    sys.exit(code)


def port(v: str) -> int:
    if not v.isdigit():
        die(f"ungültiger Port {v!r}")
    n = int(v)
    if not 1 <= n <= 65535:
        die(f"Port außerhalb 1–65535: {n}")
    return n


def ufw_installed() -> bool:
    return os.access(UFW, os.X_OK)


def _ufw(*args: str) -> subprocess.CompletedProcess:
    return subprocess.run([UFW, *args], capture_output=True, text=True, timeout=20, check=True)


def own_rules() -> list[tuple[dict, list[str]]]:
    """Gespeicherte hh-port-Regeln (auch bei ausgeschaltetem ufw): (Felder, Regel-Argumente)."""
    out = _ufw("show", "added").stdout
    found = []
    for line in out.splitlines():
        if not line.startswith("ufw route "):
            continue
        try:
            argv = shlex.split(line)[2:]
        except ValueError:
            continue
        m = OWN_RULE.match(" ".join(argv))
        if m:
            found.append((m.groupdict(), argv))
    return found


def remove(pid: str) -> None:
    if not ID_RE.match(pid):
        die("ungültige ID")
    if not ufw_installed():
        return
    for fields, argv in own_rules():
        if fields["id"] == pid:
            _ufw("--force", "route", "delete", *argv)


def apply(args: list[str]) -> None:
    if len(args) != 8:
        die("apply braucht 8 Argumente")
    pid, proto, hs, he, ip, cs, scope, wan_if = args
    if not ID_RE.match(pid):
        die("ungültige ID")
    if proto not in ("tcp", "udp"):
        die("Protokoll tcp|udp")
    if scope not in ("public", "tailnet", "off"):
        die("Reichweite public|tailnet|off")
    hstart, hend, cstart = port(hs), port(he), port(cs)
    if hend < hstart or hend - hstart >= 100:
        die("ungültiger Portbereich")
    if hstart < 1024 or any(p in RESERVED for p in range(hstart, hend + 1)):
        die("Port gesperrt")
    cend = cstart + (hend - hstart)
    if cend > 65535:
        die("Container-Portbereich zu groß")
    try:
        addr = ipaddress.ip_address(ip)
    except ValueError:
        die("ungültige IP")
    if addr not in NAT_NET:
        die("IP nicht im NAT-Netz")
    if not IF_RE.match(wan_if):
        die("ungültiges Interface")

    if not ufw_installed():
        return
    remove(pid)
    if scope == "off":
        return
    in_if = wan_if if scope == "public" else "tailscale0"
    ports = str(cstart) if cstart == cend else f"{cstart}:{cend}"
    _ufw("route", "allow", "in", "on", in_if, "out", "on", NAT_IF,
         "to", str(addr), "port", ports, "proto", proto,
         "comment", COMMENT_PREFIX + pid)


def list_rules() -> None:
    # "ufw" sagt dem Abgleich, ob es überhaupt etwas abzugleichen gibt – ohne ufw sähe sonst jede Freigabe wie
    # „Regel fehlt“ aus und würde ständig neu gesetzt.
    installed = ufw_installed()
    rules = [fields for fields, _ in own_rules()] if installed else []
    print(json.dumps({"ufw": installed, "rules": [{k: f[k] for k in ("id", "in", "ip", "port", "proto")} for f in rules]}))


def main() -> None:
    if len(sys.argv) < 2:
        die("Aktion fehlt")
    action, rest = sys.argv[1], sys.argv[2:]
    try:
        if action == "apply":
            apply(rest)
        elif action == "remove" and len(rest) == 1:
            remove(rest[0])
        elif action == "list" and not rest:
            list_rules()
        else:
            die("unbekannte Aktion")
    except subprocess.CalledProcessError as exc:
        err = exc.stderr if isinstance(exc.stderr, str) else (exc.stderr or b"").decode(errors="replace")
        die(f"ufw fehlgeschlagen: {err[:200]}", 3)


if __name__ == "__main__":
    main()
